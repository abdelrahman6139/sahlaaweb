# Public site URL (used for canonical, sitemap, hreflang, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.sahlaa.com

# Admin auth — REQUIRED in production; the login route rejects everything
# if these aren't set (fails closed, no default credential).
# ADMIN_PASSWORD is what you type on /en/login. ADMIN_TOKEN is the opaque session value.
ADMIN_PASSWORD=change-this-strong-password
ADMIN_TOKEN=change-this-to-a-long-random-string
